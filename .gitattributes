# Política multiplataforma: código, configuração e documentação são armazenados em LF.
* text=auto eol=lf

*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.sql text eol=lf
*.sh text eol=lf
.nvmrc text eol=lf

# Scripts exclusivos do Windows preservam a convenção nativa.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Assets binários nunca passam por conversão de finais de linha.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
*.zip binary
*.gz binary
*.br binary
*.mp4 binary
*.webm binary
*.mp3 binary
*.wav binary
